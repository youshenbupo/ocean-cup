/* pages/knowledge/knowledge.wxss */
.container {
  padding: 20rpx;
  background: linear-gradient(180deg, #e8f4fd 0%, #f5f5f5 200rpx);
  min-height: 100vh;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 10rpx 10rpx 10rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
}

.search-input {
  flex: 1;
  height: 60rpx;
  font-size: 28rpx;
}

.search-btn {
  width: 70rpx;
  height: 70rpx;
  line-height: 70rpx;
  text-align: center;
  font-size: 32rpx;
}

.category-scroll {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.category-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  background: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.category-item.active {
  background: linear-gradient(135deg, #1890ff, #36cfc9);
  color: #fff;
}

.knowledge-list {
  margin-bottom: 30rpx;
}

.knowledge-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
}

.card-tag.law { background: #e6f7ff; color: #1890ff; }
.card-tag.case { background: #fff7e6; color: #fa8c16; }
.card-tag.safety { background: #fff1f0; color: #f5222d; }
.card-tag.skill { background: #f6ffed; color: #52c41a; }
.card-tag.social { background: #f9f0ff; color: #722ed1; }

.card-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  flex: 1;
}

.card-summary {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.card-date {
  font-size: 22rpx;
  color: #999;
}

.card-action {
  font-size: 24rpx;
  color: #1890ff;
}

.empty-state {
  text-align: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.hotline-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.hotline-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.hotline-item {
  background: linear-gradient(135deg, #f0f9ff, #e0f7fa);
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
}

.hotline-name {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 8rpx;
}

.hotline-number {
  font-size: 36rpx;
  font-weight: bold;
  color: #1890ff;
}
