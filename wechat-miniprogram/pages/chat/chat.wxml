<!--pages/chat/chat.wxml-->
<view class="chat-container">
  <!-- 消息列表 -->
  <scroll-view class="message-list" scroll-y="true" scroll-into-view="{{scrollToView}}">
    <view class="message-item {{item.role === 'user' ? 'user-message' : 'bot-message'}}" 
          wx:for="{{messages}}" 
          wx:key="index"
          id="msg-{{index}}">
      <view class="avatar">
        <text wx:if="{{item.role === 'user'}}">👤</text>
        <text wx:else>🤖</text>
      </view>
      <view class="message-content">
        <text class="message-text">{{item.content}}</text>
      </view>
    </view>
    <view wx:if="{{isLoading}}" class="loading-indicator">
      <text>思考中...</text>
    </view>
  </scroll-view>

  <!-- 输入区域 -->
  <view class="input-area">
    <view class="input-wrapper">
      <textarea class="message-input" 
                placeholder="说说你的情况，我来帮你..." 
                value="{{inputValue}}"
                bindinput="onInput"
                bindconfirm="sendMessage"
                auto-height
                maxlength="500"/>
    </view>
    <view class="send-btn {{inputValue ? 'active' : ''}}" bindtap="sendMessage">
      <text>发送</text>
    </view>
  </view>

  <!-- 快捷问题 -->
  <view class="quick-questions" wx:if="{{messages.length <= 1}}">
    <text class="quick-title">常见问题</text>
    <view class="quick-list">
      <view class="quick-item" bindtap="askQuick" data-q="老板拖欠工资怎么办？">老板拖欠工资怎么办？</view>
      <view class="quick-item" bindtap="askQuick" data-q="工地上受伤了算工伤吗？">工地上受伤了算工伤吗？</view>
      <view class="quick-item" bindtap="askQuick" data-q="没签合同能要回工资吗？">没签合同能要回工资吗？</view>
      <view class="quick-item" bindtap="askQuick" data-q="帮我记录今天的工时">帮我记录今天的工时</view>
      <view class="quick-item" bindtap="askQuick" data-q="今天天气怎么样？">今天安全提醒</view>
    </view>
  </view>
</view>
