/* pages/chat/chat.wxss */
.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

/* 顶部导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  padding-top: calc(20rpx + env(safe-area-inset-top));
  background: linear-gradient(135deg, #1890ff, #096dd9);
  color: #fff;
}

.nav-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.nav-icon {
  font-size: 36rpx;
}

.nav-text {
  font-size: 32rpx;
  font-weight: bold;
}

.nav-btn {
  padding: 10rpx 25rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #fff;
}

/* 消息列表 */
.message-list {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
}

.message-item {
  display: flex;
  margin-bottom: 30rpx;
  align-items: flex-start;
}

.user-message {
  flex-direction: row-reverse;
}

.avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.message-content {
  max-width: 70%;
  margin: 0 20rpx;
  padding: 20rpx 30rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.user-message .message-content {
  background: #1890ff;
  color: #fff;
  border-top-right-radius: 5rpx;
}

.bot-message .message-content {
  background: #fff;
  color: #333;
  border-top-left-radius: 5rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.message-text {
  word-break: break-all;
  white-space: pre-wrap;
}

.loading-indicator {
  text-align: center;
  padding: 20rpx;
  color: #999;
  font-size: 24rpx;
}

/* 输入区域 */
.input-area {
  display: flex;
  padding: 20rpx;
  background: #fff;
  border-top: 1rpx solid #e8e8e8;
  align-items: flex-end;
}

.input-wrapper {
  flex: 1;
  background: #f5f5f5;
  border-radius: 20rpx;
  padding: 15rpx 20rpx;
}

.message-input {
  width: 100%;
  min-height: 40rpx;
  max-height: 200rpx;
  font-size: 28rpx;
}

.send-btn {
  margin-left: 20rpx;
  padding: 15rpx 30rpx;
  background: #ccc;
  color: #fff;
  border-radius: 20rpx;
  font-size: 28rpx;
}

.send-btn.active {
  background: #1890ff;
}

/* 快捷问题 */
.quick-questions {
  padding: 20rpx;
  background: #fff;
  border-top: 1rpx solid #e8e8e8;
}

.quick-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 15rpx;
}

.quick-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.quick-item {
  padding: 15rpx 25rpx;
  background: #f0f7ff;
  color: #1890ff;
  border-radius: 30rpx;
  font-size: 24rpx;
}

.quick-item.urgent {
  background: #fff2f0;
  color: #ff4d4f;
  border: 1rpx solid #ffccc7;
}

.quick-item.secondary {
  background: #f6ffed;
  color: #52c41a;
  border: 1rpx solid #b7eb8f;
}

/* 图片预览 */
.image-preview {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 15rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.remove-img {
  position: absolute;
  top: 5rpx;
  right: 5rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

/* 拍照按钮 */
.camera-btn {
  padding: 10rpx 15rpx;
  margin-right: 10rpx;
  font-size: 36rpx;
}

/* 语音按钮 */
.voice-btn {
  padding: 10rpx 15rpx;
  margin-left: 10rpx;
  font-size: 36rpx;
  transition: all 0.3s;
}

.voice-btn.recording {
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

/* 消息中的图片 */
.message-image {
  max-width: 100%;
  border-radius: 12rpx;
  margin-bottom: 10rpx;
}

/* 工具按钮 */
.tools-btn {
  padding: 10rpx 15rpx;
  margin-left: 10rpx;
  font-size: 36rpx;
  transition: all 0.3s;
}

.tools-btn:active {
  transform: scale(0.9);
}

/* 工具面板 */
.tool-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
  padding: 30rpx;
  padding-bottom: 60rpx;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  z-index: 100;
}

.tool-panel.show {
  transform: translateY(0);
}

.tool-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.tool-panel-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.tool-panel-close {
  width: 50rpx;
  height: 50rpx;
  background: #f0f0f0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #666;
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.tool-item {
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border-radius: 16rpx;
  padding: 25rpx 15rpx;
  text-align: center;
  transition: all 0.2s;
}

.tool-item:active {
  transform: scale(0.95);
  background: linear-gradient(135deg, #e9ecef 0%, #dee2e6 100%);
}

.tool-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.tool-name {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 5rpx;
}

.tool-desc {
  display: block;
  font-size: 20rpx;
  color: #999;
}
