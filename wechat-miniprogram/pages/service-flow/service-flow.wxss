/* pages/service-flow/service-flow.wxss */
.container {
  padding: 20rpx;
  background: linear-gradient(180deg, #e8f4fd 0%, #f5f5f5 200rpx);
  min-height: 100vh;
}

.intro-card {
  background: linear-gradient(135deg, #1890ff, #36cfc9);
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  text-align: center;
}

.intro-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  display: block;
  margin-bottom: 12rpx;
}

.intro-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

/* 流程图 */
.flow-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.flow-steps {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.flow-step {
  display: flex;
  align-items: center;
  width: 100%;
  position: relative;
}

.step-number {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background: linear-gradient(135deg, #1890ff, #36cfc9);
  color: #fff;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.step-content {
  flex: 1;
  margin-left: 20rpx;
  padding: 16rpx 0;
}

.step-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  display: block;
}

.step-desc {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

.step-arrow {
  position: absolute;
  left: 28rpx;
  bottom: -20rpx;
  font-size: 28rpx;
  color: #1890ff;
}

/* 智能体卡片 */
.agents-section {
  margin-bottom: 30rpx;
}

.agent-cards {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.agent-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}

.agent-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.agent-info {
  flex: 1;
}

.agent-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  display: block;
}

.agent-desc {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

.agent-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.agent-tag {
  font-size: 20rpx;
  background: #e6f7ff;
  color: #1890ff;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
}

.agent-action {
  font-size: 24rpx;
  color: #1890ff;
  flex-shrink: 0;
}

/* 工作原理 */
.principle-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.principle-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.principle-item {
  display: flex;
  align-items: flex-start;
}

.principle-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.principle-content {
  flex: 1;
}

.principle-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  display: block;
}

.principle-desc {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-top: 4rpx;
  line-height: 1.5;
}
