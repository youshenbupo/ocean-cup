/* pages/index/index.wxss */
.container {
  min-height: 100vh;
  background: #f0f2f5;
  padding-bottom: 40rpx;
  position: relative;
  overflow: hidden;
}

/* 背景装饰 */
.bg-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  overflow: hidden;
  z-index: 0;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.15;
}

.bg-circle-1 {
  width: 300rpx;
  height: 300rpx;
  background: linear-gradient(135deg, #1890ff, #36cfc9);
  top: -100rpx;
  right: -50rpx;
}

.bg-circle-2 {
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, #36cfc9, #52c41a);
  top: 100rpx;
  left: -60rpx;
}

/* 欢迎区域 */
.welcome-section {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 40rpx;
}

.logo-wrapper {
  position: relative;
  margin-bottom: 20rpx;
}

.logo-icon {
  width: 140rpx;
  height: 140rpx;
  line-height: 140rpx;
  text-align: center;
  font-size: 80rpx;
  background: linear-gradient(135deg, #fff, #f0f9ff);
  border-radius: 36rpx;
  box-shadow: 0 12rpx 40rpx rgba(24, 144, 255, 0.2);
}

.logo-badge {
  position: absolute;
  bottom: -8rpx;
  right: -8rpx;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: linear-gradient(135deg, #1890ff, #36cfc9);
  color: #fff;
  font-size: 22rpx;
  font-weight: bold;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-top: 16rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #666;
  margin-top: 8rpx;
}

/* 通用区块样式 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.section-more {
  font-size: 24rpx;
  color: #1890ff;
}

/* 智能体工作区 */
.workspace-section {
  position: relative;
  z-index: 1;
  padding: 0 24rpx;
  margin-bottom: 30rpx;
}

.workspace-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.workspace-card {
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
  height: 160rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.08);
}

.workspace-card.large {
  grid-column: span 2;
  height: 180rpx;
}

.card-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.legal-bg { background: linear-gradient(135deg, #1890ff, #096dd9); }
.safety-bg { background: linear-gradient(135deg, #f5222d, #cf1322); }
.salary-bg { background: linear-gradient(135deg, #fa8c16, #d46b08); }
.skill-bg { background: linear-gradient(135deg, #52c41a, #389e0d); }
.life-bg { background: linear-gradient(135deg, #722ed1, #531dab); }

.card-content {
  position: relative;
  z-index: 1;
  padding: 24rpx;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.workspace-card.large .card-content {
  flex-direction: row;
  align-items: center;
}

.card-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.workspace-card.large .card-icon {
  font-size: 64rpx;
  margin-right: 24rpx;
}

.card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}

.workspace-card.large .card-name {
  font-size: 36rpx;
}

.card-desc {
  font-size: 22rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 4rpx;
}

/* 工具区 */
.tools-section {
  padding: 0 24rpx;
  margin-bottom: 30rpx;
}

.tools-grid {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 0;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
}

.tool-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.tool-name {
  font-size: 22rpx;
  color: #666;
}

/* 紧急求助 */
.urgent-section {
  padding: 0 24rpx;
  margin-bottom: 30rpx;
}

.urgent-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.urgent-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}

.urgent-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.urgent-info {
  flex: 1;
}

.urgent-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  display: block;
}

.urgent-desc {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

.urgent-call {
  font-size: 24rpx;
  color: #fff;
  background: linear-gradient(135deg, #f5222d, #cf1322);
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
}

/* 底部 */
.footer {
  text-align: center;
  padding: 40rpx 0 20rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #999;
  display: block;
}

.footer-sub {
  font-size: 22rpx;
  color: #bbb;
  display: block;
  margin-top: 8rpx;
}
