/* pages/index/index.wxss */
.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 欢迎区域 */
.welcome-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
  background: linear-gradient(135deg, #1890ff, #36cfc9);
  border-radius: 20rpx;
  margin-bottom: 30rpx;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 功能网格 */
.feature-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.feature-item {
  width: 31%;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.feature-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 15rpx;
}

.feature-icon.legal { background: #e6f7ff; }
.feature-icon.safety { background: #fff7e6; }
.feature-icon.salary { background: #f6ffed; }
.feature-icon.skill { background: #f9f0ff; }
.feature-icon.life { background: #fff1f0; }
.feature-icon.community { background: #e6fffb; }

.feature-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 22rpx;
  color: #999;
  text-align: center;
}

/* 快捷功能 */
.quick-actions {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.quick-actions.urgent {
  background: linear-gradient(135deg, #fff5f5, #fff);
  border: 1rpx solid #ffccc7;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.action-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.action-item {
  flex: 1 1 calc(50% - 8rpx);
  min-width: calc(50% - 8rpx);
  padding: 24rpx 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #333;
  text-align: center;
  box-sizing: border-box;
  transition: all 0.2s;
}

.action-item:active {
  background: #e6f7ff;
  transform: scale(0.98);
}

.action-item.urgent-item {
  background: #fff1f0;
  color: #cf1322;
  border: 1rpx solid #ffa39e;
}

.action-item.urgent-item:active {
  background: #ffccc7;
}

.action-item:last-child {
  border-bottom: none;
}
